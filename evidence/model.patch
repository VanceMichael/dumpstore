diff --git a/internal/broker/journal.go b/internal/broker/journal.go
new file mode 100644
index 0000000..ad1b93a
--- /dev/null
+++ b/internal/broker/journal.go
@@ -0,0 +1,190 @@
+package broker
+
+import (
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"sync"
+)
+
+// ErrJournalClosed is returned by Publish after the journal has been sealed
+// (e.g. an operation reached its terminal state).
+var ErrJournalClosed = errors.New("journal closed")
+
+// subscriberBufferSize mirrors the buffer size of plain Broker subscriber
+// channels: a lagging consumer is dropped rather than stalling publishers.
+const subscriberBufferSize = 32
+
+// Event is one sequenced journal entry. Data is the JSON-encoded payload as
+// supplied to Publish; Seq is assigned by the journal and is unique for the
+// journal's lifetime.
+type Event struct {
+	Seq  int64
+	Data []byte
+}
+
+// Journal is a bounded, ordered, replayable event stream.
+//
+// Unlike Broker (last-value cache per topic), a Journal keeps a sliding
+// window of every published event so a subscriber can resume from the last
+// sequence it has already seen (SSE Last-Event-ID semantics). Delivery is
+// non-blocking: when a subscriber's buffer fills it is closed and removed,
+// exactly like Broker's slow-consumer policy; the client reconnects and
+// replays the gap from the retained window.
+//
+// The zero value is not usable; use NewJournal.
+type Journal struct {
+	mu       sync.Mutex
+	buf      []Event // retained sliding window, oldest first
+	total    int     // sum of len(Data) over buf
+	nextSeq  int64   // seq assigned by the last Publish; 0 before the first
+	stepCap  int     // maximum retained events
+	bytesCap int     // maximum retained payload bytes
+	closed   bool
+	subs     []chan Event
+}
+
+// NewJournal returns a Journal retaining at most stepCap events and
+// bytesCap payload bytes (the newest event is always retained even when it
+// alone exceeds bytesCap). Non-positive caps are treated as 1.
+func NewJournal(stepCap, bytesCap int) *Journal {
+	if stepCap < 1 {
+		stepCap = 1
+	}
+	if bytesCap < 1 {
+		bytesCap = 1
+	}
+	return &Journal{stepCap: stepCap, bytesCap: bytesCap}
+}
+
+// Publish JSON-encodes data, assigns it the next sequence number, appends it
+// to the retained window (evicting oldest entries to satisfy the caps) and
+// delivers it to every current subscriber. Slow subscribers are dropped.
+// After Close, Publish returns ErrJournalClosed.
+func (j *Journal) Publish(data any) (Event, error) {
+	payload, err := json.Marshal(data)
+	if err != nil {
+		return Event{}, err
+	}
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	if j.closed {
+		return Event{}, ErrJournalClosed
+	}
+	j.nextSeq++
+	ev := Event{Seq: j.nextSeq, Data: payload}
+	j.buf = append(j.buf, ev)
+	j.total += len(payload)
+	j.trimLocked()
+	j.deliverLocked(ev)
+	return ev, nil
+}
+
+// trimLocked evicts oldest events until both caps are satisfied. The newest
+// event is always kept. Caller must hold j.mu.
+func (j *Journal) trimLocked() {
+	for len(j.buf) > 1 && (len(j.buf) > j.stepCap || j.total > j.bytesCap) {
+		j.total -= len(j.buf[0].Data)
+		j.buf[0] = Event{} // help GC
+		j.buf = j.buf[1:]
+	}
+}
+
+// deliverLocked sends ev to every subscriber, closing and removing any whose
+// buffer is full. Caller must hold j.mu.
+func (j *Journal) deliverLocked(ev Event) {
+	n := 0
+	for _, ch := range j.subs {
+		select {
+		case ch <- ev:
+			j.subs[n] = ch
+			n++
+		default:
+			slog.Warn("journal: subscriber slow, closing stream", "seq", ev.Seq)
+			close(ch)
+		}
+	}
+	for i := n; i < len(j.subs); i++ {
+		j.subs[i] = nil
+	}
+	j.subs = j.subs[:n]
+}
+
+// Replay returns the retained events with Seq strictly greater than afterSeq
+// and the latest assigned seq (0 when nothing has been published). Callers
+// compare afterSeq with OldestSeq to tell "nothing new" apart from
+// "position older than the retained window".
+func (j *Journal) Replay(afterSeq int64) (events []Event, latest int64) {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	events = make([]Event, 0, len(j.buf))
+	for _, ev := range j.buf {
+		if ev.Seq > afterSeq {
+			events = append(events, ev)
+		}
+	}
+	return events, j.nextSeq
+}
+
+// OldestSeq returns the seq of the oldest still-retained event. It is 0 when
+// nothing has been published, and equals LatestSeq when only one event
+// remains. A resume position below OldestSeq means the gap has aged out and
+// the caller needs a full snapshot rather than event replay.
+func (j *Journal) OldestSeq() int64 {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	if len(j.buf) == 0 {
+		return 0
+	}
+	return j.buf[0].Seq
+}
+
+// Subscribe registers a subscriber and returns the retained events newer
+// than afterSeq (the initial replay), the live event channel, and the
+// latest assigned seq. Events published after subscription are delivered on
+// the channel until it is closed (slow consumer) or Unsubscribe is called.
+// Subscribing to a closed journal is allowed so late subscribers can read
+// the terminal state via replay; use Closed to distinguish.
+func (j *Journal) Subscribe(afterSeq int64) (initial []Event, ch chan Event, latest int64) {
+	ch = make(chan Event, subscriberBufferSize)
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	initial = make([]Event, 0, len(j.buf))
+	for _, ev := range j.buf {
+		if ev.Seq > afterSeq {
+			initial = append(initial, ev)
+		}
+	}
+	j.subs = append(j.subs, ch)
+	return initial, ch, j.nextSeq
+}
+
+// Unsubscribe removes ch and closes it. A channel already removed (slow
+// consumer drop) is a no-op.
+func (j *Journal) Unsubscribe(ch chan Event) {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	for i, c := range j.subs {
+		if c == ch {
+			j.subs = append(j.subs[:i], j.subs[i+1:]...)
+			close(ch)
+			return
+		}
+	}
+}
+
+// Close seals the journal: further Publish calls fail with ErrJournalClosed.
+// Existing subscribers are not closed — terminal delivery happens through
+// the final event, and late subscribers keep replay access.
+func (j *Journal) Close() {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	j.closed = true
+}
+
+// Closed reports whether the journal has been sealed.
+func (j *Journal) Closed() bool {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	return j.closed
+}
diff --git a/internal/broker/journal_test.go b/internal/broker/journal_test.go
new file mode 100644
index 0000000..d902ace
--- /dev/null
+++ b/internal/broker/journal_test.go
@@ -0,0 +1,295 @@
+package broker
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func drain(ch chan Event, timeout time.Duration) []Event {
+	var out []Event
+	for {
+		select {
+		case ev, ok := <-ch:
+			if !ok {
+				return out
+			}
+			out = append(out, ev)
+		case <-time.After(timeout):
+			return out
+		}
+	}
+}
+
+func TestJournalPublishAssignsMonotonicSeq(t *testing.T) {
+	j := NewJournal(100, 1<<20)
+	for i := int64(1); i <= 10; i++ {
+		ev, err := j.Publish(i)
+		if err != nil {
+			t.Fatalf("publish %d: %v", i, err)
+		}
+		if ev.Seq != i {
+			t.Fatalf("seq = %d, want %d", ev.Seq, i)
+		}
+	}
+	events, latest := j.Replay(0)
+	if latest != 10 || len(events) != 10 {
+		t.Fatalf("replay: latest=%d len=%d", latest, len(events))
+	}
+	for i, ev := range events {
+		if ev.Seq != int64(i+1) {
+			t.Fatalf("replay seq at %d = %d", i, ev.Seq)
+		}
+	}
+}
+
+func TestJournalReplayAfter(t *testing.T) {
+	j := NewJournal(100, 1<<20)
+	for i := 0; i < 5; i++ {
+		if _, err := j.Publish(i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	tests := []struct {
+		after   int64
+		wantLen int
+		wantSeq int64 // first expected seq
+	}{
+		{0, 5, 1}, // from start
+		{2, 3, 3}, // strict >
+		{5, 0, 0}, // caught up: nothing new
+		{99, 0, 0},
+	}
+	for _, tt := range tests {
+		events, latest := j.Replay(tt.after)
+		if len(events) != tt.wantLen {
+			t.Errorf("after=%d: got %d events, want %d", tt.after, len(events), tt.wantLen)
+		}
+		if tt.wantLen > 0 && (events[0].Seq != tt.wantSeq || latest != 5) {
+			t.Errorf("after=%d: first=%d latest=%d", tt.after, events[0].Seq, latest)
+		}
+	}
+}
+
+func TestJournalSubscribeReplayThenLive(t *testing.T) {
+	j := NewJournal(100, 1<<20)
+	for i := 0; i < 3; i++ {
+		if _, err := j.Publish(i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	initial, ch, latest := j.Subscribe(2)
+	if latest != 3 || len(initial) != 1 || initial[0].Seq != 3 {
+		t.Fatalf("initial replay: latest=%d initial=%v", latest, initial)
+	}
+	for i := 3; i < 6; i++ {
+		if _, err := j.Publish(i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	live := drain(ch, 200*time.Millisecond)
+	if len(live) != 3 {
+		t.Fatalf("got %d live events, want 3", len(live))
+	}
+	for i, ev := range live {
+		if ev.Seq != int64(i+4) {
+			t.Fatalf("live[%d] seq=%d, want %d", i, ev.Seq, i+4)
+		}
+	}
+	j.Unsubscribe(ch)
+	if _, ok := <-ch; ok {
+		t.Fatal("channel should be closed after Unsubscribe")
+	}
+	// Unsubscribe twice is a no-op.
+	j.Unsubscribe(ch)
+}
+
+func TestJournalSlowSubscriberDroppedOthersUnaffected(t *testing.T) {
+	j := NewJournal(1000, 1<<20)
+	_, chSlow, _ := j.Subscribe(0)
+	_, chFast, _ := j.Subscribe(0)
+
+	// The fast subscriber drains continuously; the slow one never reads.
+	var fastMu sync.Mutex
+	var fastSeqs []int64
+	fastDone := make(chan struct{})
+	go func() {
+		defer close(fastDone)
+		for ev := range chFast {
+			fastMu.Lock()
+			fastSeqs = append(fastSeqs, ev.Seq)
+			fastMu.Unlock()
+		}
+	}()
+
+	const published = subscriberBufferSize + 10
+	publishDone := make(chan struct{})
+	go func() {
+		for i := 0; i < published; i++ {
+			if _, err := j.Publish(i); err != nil {
+				t.Errorf("publish: %v", err)
+				return
+			}
+		}
+		close(publishDone)
+	}()
+	select {
+	case <-publishDone:
+	case <-time.After(time.Second):
+		t.Fatal("publisher blocked on slow subscriber")
+	}
+
+	// Slow channel gets closed by the journal.
+	deadline := time.After(time.Second)
+	for {
+		select {
+		case _, ok := <-chSlow:
+			if !ok {
+				goto dropped
+			}
+		case <-deadline:
+			t.Fatal("slow subscriber was not dropped")
+		}
+	}
+dropped:
+
+	j.Unsubscribe(chFast)
+	<-fastDone
+	fastMu.Lock()
+	got := len(fastSeqs)
+	fastMu.Unlock()
+	if got != published {
+		t.Fatalf("fast subscriber got %d events, want %d", got, published)
+	}
+
+	// A fresh subscription replays the whole retained sequence: the
+	// slow consumer reconnects along the same path without a gap.
+	initial, ch2, latest := j.Subscribe(0)
+	if latest != published {
+		t.Fatalf("latest = %d, want %d", latest, published)
+	}
+	seqs := map[int64]bool{}
+	for _, ev := range initial {
+		seqs[ev.Seq] = true
+	}
+	for _, ev := range drain(ch2, 100*time.Millisecond) {
+		seqs[ev.Seq] = true
+	}
+	if len(seqs) != published {
+		t.Fatalf("reconnect replay has %d unique seqs, want %d", len(seqs), published)
+	}
+	j.Unsubscribe(ch2)
+}
+
+func TestJournalStepCapEvictsOldest(t *testing.T) {
+	j := NewJournal(5, 1<<20)
+	for i := 0; i < 20; i++ {
+		if _, err := j.Publish(i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	events, latest := j.Replay(0)
+	if len(events) != 5 {
+		t.Fatalf("retained %d events, want 5", len(events))
+	}
+	if events[0].Seq != 16 || events[4].Seq != 20 || latest != 20 {
+		t.Fatalf("eviction window: %+v latest=%d", events, latest)
+	}
+	if j.OldestSeq() != 16 {
+		t.Fatalf("OldestSeq = %d, want 16", j.OldestSeq())
+	}
+}
+
+func TestJournalBytesCapEvictsOldest(t *testing.T) {
+	// Each payload marshals to 2 bytes ("42"); cap at ~5 payloads.
+	j := NewJournal(1000, 10)
+	for i := 0; i < 10; i++ {
+		if _, err := j.Publish(42); err != nil {
+			t.Fatal(err)
+		}
+	}
+	events, _ := j.Replay(0)
+	if len(events) != 5 {
+		t.Fatalf("bytes cap retained %d events, want 5", len(events))
+	}
+	// Newest oversized event is always retained.
+	j2 := NewJournal(1000, 1)
+	if _, err := j2.Publish("a payload much larger than the cap"); err != nil {
+		t.Fatal(err)
+	}
+	events, _ = j2.Replay(0)
+	if len(events) != 1 {
+		t.Fatalf("newest event should always be retained, got %d", len(events))
+	}
+}
+
+func TestJournalBoundedAfter10kPublishes(t *testing.T) {
+	j := NewJournal(500, 64*1024)
+	for i := 0; i < 10_000; i++ {
+		if _, err := j.Publish(i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	events, _ := j.Replay(0)
+	if len(events) > 500 {
+		t.Fatalf("retained %d events, cap 500", len(events))
+	}
+	if events[len(events)-1].Seq != 10_000 {
+		t.Fatalf("latest retained seq = %d, want 10000", events[len(events)-1].Seq)
+	}
+}
+
+func TestJournalCloseSealsButKeepsReplay(t *testing.T) {
+	j := NewJournal(100, 1<<20)
+	if _, err := j.Publish("terminal"); err != nil {
+		t.Fatal(err)
+	}
+	j.Close()
+	if !j.Closed() {
+		t.Fatal("Closed() = false")
+	}
+	if _, err := j.Publish("after close"); !errors.Is(err, ErrJournalClosed) {
+		t.Fatalf("after close err = %v, want ErrJournalClosed", err)
+	}
+	events, latest := j.Replay(0)
+	if latest != 1 || len(events) != 1 {
+		t.Fatalf("replay after close: %+v latest=%d", events, latest)
+	}
+	// Late subscription still works for terminal state.
+	initial, ch, _ := j.Subscribe(0)
+	if len(initial) != 1 {
+		t.Fatalf("late subscriber initial = %d events", len(initial))
+	}
+	j.Unsubscribe(ch)
+}
+
+func TestJournalConcurrent(t *testing.T) {
+	j := NewJournal(1000, 1<<20)
+	const publishers, per, subscribers = 10, 100, 4
+	var wg sync.WaitGroup
+	chans := make([]chan Event, subscribers)
+	for i := range chans {
+		_, ch, _ := j.Subscribe(0)
+		chans[i] = ch
+	}
+	for p := 0; p < publishers; p++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < per; i++ {
+				if _, err := j.Publish(i); err != nil {
+					t.Errorf("publish: %v", err)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	events, latest := j.Replay(0)
+	if latest != publishers*per || len(events) != publishers*per {
+		t.Fatalf("latest=%d retained=%d, want %d", latest, len(events), publishers*per)
+	}
+	for _, ch := range chans {
+		j.Unsubscribe(ch)
+	}
+}
