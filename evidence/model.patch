+			}
+			for i := range got {
+				if got[i] != tc.want[i] {
+					t.Errorf("conflict[%d] = %#v, want %#v", i, got[i], tc.want[i])
+				}
+			}
+		})
+	}
+}
+
+func TestHomesBasePath(t *testing.T) {
+	tests := map[string]string{
+		"/tank/data/%U":   "/tank/data",
+		"/tank/data/%u":   "/tank/data",
+		"/tank/data/%U/":  "/tank/data",
+		"/tank/data/homes": "/tank/data/homes",
+		"/tank/data/":     "/tank/data",
+		"  /tank/x/%U ":   "/tank/x",
+	}
+	for in, want := range tests {
+		if got := homesBasePath(in); got != want {
+			t.Errorf("homesBasePath(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestGuardSerialises(t *testing.T) {
+	// Sanity: Guard is a plain mutex usable as the admission boundary.
+	g := NewGuard()
+	g.Lock()
+	got := make(chan struct{})
+	go func() {
+		g.Lock()
+		defer g.Unlock()
+		close(got)
+	}()
+	select {
+	case <-got:
+		t.Fatal("guard did not serialise")
+	default:
+	}
+	g.Unlock()
+}
diff --git a/internal/smb/usershares.go b/internal/smb/usershares.go
new file mode 100644
index 0000000..33cbe05
--- /dev/null
+++ b/internal/smb/usershares.go
@@ -0,0 +1,81 @@
+package smb
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Usershare is one Samba usershare file in dumpstore's managed usershare
+// directory. The file name (written by `net usershare add`) is the share name.
+type Usershare struct {
+	Name string
+	Path string
+}
+
+// ListUsershares reads every usershare definition directly from the
+// dumpstore-managed usershare directory. The directory is owned exclusively
+// by dumpstore (see UsershareDir), so its files are an authoritative set
+// that does not depend on parsing `net usershare info` exit codes.
+//
+// A missing directory means SMB has never been initialised and yields a nil
+// slice with no error. Any other read failure, or a malformed usershare file
+// without a parseable path, is returned so callers (the pre-destroy reference
+// guard) can fail closed.
+func ListUsershares(goos string) ([]Usershare, error) {
+	return listUsersharesDir(UsershareDir(goos))
+}
+
+func listUsersharesDir(dir string) ([]Usershare, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("read usershare dir %s: %w", dir, err)
+	}
+
+	var shares []Usershare
+	for _, e := range entries {
+		if e.IsDir() || strings.HasPrefix(e.Name(), ".") {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(dir, e.Name()))
+		if err != nil {
+			return nil, fmt.Errorf("read usershare %s: %w", e.Name(), err)
+		}
+		path, ok := parseUsersharePath(data)
+		if !ok {
+			return nil, fmt.Errorf("usershare %q has no parseable path", e.Name())
+		}
+		shares = append(shares, Usershare{Name: e.Name(), Path: path})
+	}
+	return shares, nil
+}
+
+// parseUsersharePath extracts the path= value from a `net usershare` file.
+// File layout (stable Samba format), one key=value per line:
+//
+//	#VERSION 0
+//	path=/tank/data
+//	comment=
+//	usershare_acl=S-1-1-0:F
+//	guest_ok=n
+func parseUsersharePath(data []byte) (string, bool) {
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
+			continue
+		}
+		key, val, found := strings.Cut(line, "=")
+		if !found {
+			continue
+		}
+		if strings.TrimSpace(key) == "path" {
+			val = strings.TrimSpace(val)
+			return val, val != ""
+		}
+	}
+	return "", false
+}
diff --git a/internal/smb/usershares_test.go b/internal/smb/usershares_test.go
new file mode 100644
index 0000000..9f6a3f1
--- /dev/null
+++ b/internal/smb/usershares_test.go
@@ -0,0 +1,81 @@
+package smb
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+func TestParseUsersharePath(t *testing.T) {
+	content := "#VERSION 0\npath=/tank/data/docs\ncomment=\nusershare_acl=S-1-1-0:F\nguest_ok=n\n"
+	if got, ok := parseUsersharePath([]byte(content)); !ok || got != "/tank/data/docs" {
+		t.Fatalf("parseUsersharePath = %q, %v", got, ok)
+	}
+
+	if _, ok := parseUsersharePath([]byte("#VERSION 0\ncomment=\nguest_ok=n\n")); ok {
+		t.Fatal("expected no path to be reported as unparseable")
+	}
+
+	if _, ok := parseUsersharePath(nil); ok {
+		t.Fatal("nil content must not yield a path")
+	}
+}
+
+func TestListUsersharesMissingDir(t *testing.T) {
+	// UsershareDir points at a system path on the dev host (macOS) where it
+	// does not exist; this must be an empty, non-error result.
+	if got := filepath.Base(UsershareDir(runtime.GOOS)); got != "usershares" {
+		t.Fatalf("unexpected usershare dir tail: %q", got)
+	}
+	shares, err := ListUsershares(runtime.GOOS)
+	if err != nil {
+		t.Fatalf("missing usershare dir must not error: %v", err)
+	}
+	if len(shares) != 0 {
+		t.Fatalf("expected no shares, got %#v", shares)
+	}
+}
+
+func TestListUsersharesDir(t *testing.T) {
+	dir := t.TempDir()
+
+	write := func(name, content string) {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	write("good", "#VERSION 0\npath=/tank/a\nusershare_acl=S-1-1-0:F\nguest_ok=n\n")
+	write("other", "path=/tank/b\n")
+	if err := os.Mkdir(filepath.Join(dir, "subdir"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	write(".hidden", "path=/tank/hidden\n")
+
+	shares, err := listUsersharesDir(dir)
+	if err != nil {
+		t.Fatalf("listUsersharesDir: %v", err)
+	}
+	if len(shares) != 2 {
+		t.Fatalf("expected 2 shares (dotfiles and dirs skipped), got %#v", shares)
+	}
+	got := map[string]string{}
+	for _, s := range shares {
+		got[s.Name] = s.Path
+	}
+	if got["good"] != "/tank/a" || got["other"] != "/tank/b" {
+		t.Fatalf("unexpected shares: %#v", got)
+	}
+}
+
+func TestListUsersharesMalformedFails(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "broken"), []byte("#VERSION 0\ncomment=\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := listUsersharesDir(dir); err == nil {
+		t.Fatal("malformed usershare file must produce an error so callers fail closed")
+	}
+}
