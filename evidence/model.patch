+++ b/internal/operations/context.go
@@ -0,0 +1,19 @@
+package operations
+
+import "context"
+
+type ctxKey struct{}
+
+// WithContext returns a context carrying op so the execution lanes and the
+// audit logger can discover the current operation without an explicit
+// parameter through every helper.
+func WithContext(ctx context.Context, op *Operation) context.Context {
+	return context.WithValue(ctx, ctxKey{}, op)
+}
+
+// FromContext returns the operation attached to ctx, or nil when the request
+// path did not begin one.
+func FromContext(ctx context.Context) *Operation {
+	op, _ := ctx.Value(ctxKey{}).(*Operation)
+	return op
+}
diff --git a/internal/operations/manager.go b/internal/operations/manager.go
new file mode 100644
index 0000000..6774bd6
--- /dev/null
+++ b/internal/operations/manager.go
@@ -0,0 +1,378 @@
+package operations
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"log/slog"
+	"regexp"
+	"sort"
+	"sync"
+	"time"
+
+	"dumpstore/internal/ansible"
+	"dumpstore/internal/broker"
+)
+
+// History bounds (see spec FR-14). Named constants so operators/reviewers
+// have one place to adjust retention.
+const (
+	// DefaultMaxStepsPerOperation is the per-operation step ring size.
+	DefaultMaxStepsPerOperation = 500
+	// DefaultMaxStepMsgBytes caps a single step message (ansible stdout).
+	DefaultMaxStepMsgBytes = 16 * 1024
+	// DefaultRetainMax is the number of terminal operations kept in memory.
+	DefaultRetainMax = 200
+	// DefaultRetentionTTL is how long a terminal operation remains queryable.
+	DefaultRetentionTTL = time.Hour
+	// DefaultTombstoneMax bounds the ring of evicted IDs that still answer
+	// 410 instead of 404.
+	DefaultTombstoneMax = 256
+	// journalBytesCap bounds the replay journal payload memory per operation
+	// (500 steps × a few hundred bytes typical); oversized single steps are
+	// still retained as the newest event, mirroring Journal semantics.
+	journalBytesCap = 512 * 1024
+
+	serverIDBytes = 12 // 24 hex chars, matching jobs.ID style
+)
+
+// Config holds the bounded-history parameters of a Manager.
+type Config struct {
+	MaxStepsPerOperation int
+	MaxStepMsgBytes      int
+	RetainMax            int
+	RetentionTTL         time.Duration
+	TombstoneMax         int
+}
+
+// DefaultConfig returns the production retention settings.
+func DefaultConfig() Config {
+	return Config{
+		MaxStepsPerOperation: DefaultMaxStepsPerOperation,
+		MaxStepMsgBytes:      DefaultMaxStepMsgBytes,
+		RetainMax:            DefaultRetainMax,
+		RetentionTTL:         DefaultRetentionTTL,
+		TombstoneMax:         DefaultTombstoneMax,
+	}
+}
+
+func (c Config) withDefaults() Config {
+	d := DefaultConfig()
+	if c.MaxStepsPerOperation <= 0 {
+		c.MaxStepsPerOperation = d.MaxStepsPerOperation
+	}
+	if c.MaxStepMsgBytes <= 0 {
+		c.MaxStepMsgBytes = d.MaxStepMsgBytes
+	}
+	if c.RetainMax <= 0 {
+		c.RetainMax = d.RetainMax
+	}
+	if c.RetentionTTL <= 0 {
+		c.RetentionTTL = d.RetentionTTL
+	}
+	if c.TombstoneMax <= 0 {
+		c.TombstoneMax = d.TombstoneMax
+	}
+	return c
+}
+
+// StartOutcome tells an API caller whether Start created a new operation or
+// resolved a replayed (idempotent) request.
+type StartOutcome int
+
+const (
+	StartCreated StartOutcome = iota
+	StartReplayRunning
+	StartReplayTerminal
+)
+
+// tombstone records an evicted operation ID so callers get a definitive 410
+// ("existed, now gone") rather than a 404 ("never seen").
+type tombstone struct {
+	id       string
+	prunedAt time.Time
+}
+
+// Manager owns live, retained and tombstoned operations. Safe for concurrent
+// use.
+type Manager struct {
+	cfg Config
+	now func() time.Time
+
+	mu         sync.Mutex
+	ops        map[string]*Operation
+	tombstones []tombstone
+
+	accepts  int64
+	finished map[Status]int64
+}
+
+// NewManager constructs a Manager with production bounds.
+func NewManager(cfg Config) *Manager {
+	return newManager(cfg, func() time.Time { return time.Now().UTC() })
+}
+
+func newManager(cfg Config, now func() time.Time) *Manager {
+	return &Manager{
+		cfg:      cfg.withDefaults(),
+		now:      now,
+		ops:      make(map[string]*Operation),
+		finished: make(map[Status]int64),
+	}
+}
+
+// clientIDRe accepts canonical op_<UUID> identifiers generated by browsers
+// (X-Operation-ID). Strict canonical shape keeps the header free-form-proof.
+var clientIDRe = regexp.MustCompile(`^op_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$`)
+
+// ValidClientID reports whether proposedID is a syntactically acceptable
+// client-generated operation ID.
+func ValidClientID(id string) bool { return clientIDRe.MatchString(id) }
+
+func newServerID() (string, error) {
+	var b [serverIDBytes]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(b[:]), nil
+}
+
+// Start accepts a change into the registry.
+//
+// proposedID empty → a server-generated hex ID is assigned.
+// proposedID set → it must match the canonical client shape; an existing ID
+// returns the existing operation with StartReplayRunning/StartReplayTerminal
+// and MUST NOT be executed again.
+//
+// Replaying an expired ID returns ErrExpired; a malformed ID returns
+// ErrInvalidID.
+func (m *Manager) Start(proposedID, action, target, reqID string) (*Operation, StartOutcome, error) {
+	if proposedID != "" && !ValidClientID(proposedID) {
+		return nil, 0, ErrInvalidID
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	m.evictExpiredLocked()
+
+	if proposedID != "" {
+		if _, buried := m.tombstoneIndexLocked(proposedID); buried {
+			return nil, 0, ErrExpired
+		}
+		if existing, ok := m.ops[proposedID]; ok {
+			if existing.Snapshot().Status.Terminal() {
+				return existing, StartReplayTerminal, nil
+			}
+			return existing, StartReplayRunning, nil
+		}
+	}
+
+	id := proposedID
+	if id == "" {
+		var err error
+		id, err = newServerID()
+		if err != nil {
+			return nil, 0, err
+		}
+	}
+
+	now := m.now()
+	op := &Operation{
+		rec: Record{
+			ID:        id,
+			Action:    action,
+			Target:    target,
+			ReqID:     reqID,
+			Status:    StatusRunning,
+			Steps:     []Step{},
+			StartedAt: now,
+		},
+		outcome: "",
+		journal: broker.NewJournal(m.cfg.MaxStepsPerOperation, journalBytesCap),
+		done:    make(chan struct{}),
+		started: now,
+	}
+	m.ops[id] = op
+	m.accepts++
+
+	slog.Info("operation accepted",
+		"op_id", id, "req_id", reqID, "action", action, "target", target)
+	return op, StartCreated, nil
+}
+
+// Get returns the operation for id, or ErrExpired/ErrNotFound.
+func (m *Manager) Get(id string) (*Operation, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	m.evictExpiredLocked()
+	if _, buried := m.tombstoneIndexLocked(id); buried {
+		return nil, ErrExpired
+	}
+	if op, ok := m.ops[id]; ok {
+		return op, nil
+	}
+	if !validLookupID(id) {
+		return nil, ErrInvalidID
+	}
+	return nil, ErrNotFound
+}
+
+// validLookupID accepts either client UUID IDs or server-generated 24-hex IDs.
+func validLookupID(id string) bool {
+	if ValidClientID(id) {
+		return true
+	}
+	if len(id) != 2*serverIDBytes {
+		return false
+	}
+	for _, c := range id {
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+// complete is called by an operation's response finaliser: it freezes the
+// terminal state, updates counters and runs retention pruning.
+func (m *Manager) complete(op *Operation, httpStatus int) {
+	now := m.now()
+	if !op.finish(httpStatus, now) {
+		return // already terminal
+	}
+	rec := op.Snapshot()
+
+	m.mu.Lock()
+	m.finished[rec.Status]++
+	m.pruneLocked(now)
+	m.mu.Unlock()
+}
+
+// pruneLocked evicts terminal operations beyond RetainMax (oldest first) and
+// any terminal operation older than RetentionTTL. Running operations are
+// never evicted. Evicted IDs enter the bounded tombstone ring.
+func (m *Manager) pruneLocked(now time.Time) {
+	type item struct {
+		id string
+		at time.Time
+	}
+	var terminals []item
+	for id, op := range m.ops {
+		rec := op.Snapshot()
+		if rec.Status.Terminal() {
+			terminals = append(terminals, item{id, rec.FinishedAt})
+		}
+	}
+	// Fast path: within the count cap and nothing TTL-expired.
+	overCount := len(terminals) > m.cfg.RetainMax
+	if !overCount {
+		stale := false
+		for _, it := range terminals {
+			if now.Sub(it.at) > m.cfg.RetentionTTL {
+				stale = true
+				break
+			}
+		}
+		if !stale {
+			return
+		}
+	}
+	// Oldest terminal first.
+	sort.Slice(terminals, func(i, j int) bool { return terminals[i].at.Before(terminals[j].at) })
+
+	evict := len(terminals) - m.cfg.RetainMax // must evict at least this many by count
+	for _, it := range terminals {
+		byTTL := now.Sub(it.at) > m.cfg.RetentionTTL
+		if byTTL || evict > 0 {
+			delete(m.ops, it.id)
+			m.pushTombstoneLocked(tombstone{id: it.id, prunedAt: now})
+			evict--
+		}
+	}
+}
+
+// runningCountLocked counts non-terminal operations; caller holds m.mu.
+func (m *Manager) runningCountLocked() int {
+	n := 0
+	for _, op := range m.ops {
+		if op.Snapshot().Status == StatusRunning {
+			n++
+		}
+	}
+	return n
+}
+
+// evictExpiredLocked drops tombstones older than the TTL. Terminal operations
+// past their TTL are pruned here too so lazy lookups cannot resurrect them.
+func (m *Manager) evictExpiredLocked() {
+	now := m.now()
+	kept := m.tombstones[:0]
+	for _, ts := range m.tombstones {
+		if now.Sub(ts.prunedAt) <= m.cfg.RetentionTTL {
+			kept = append(kept, ts)
+		}
+	}
+	m.tombstones = kept
+	m.pruneLocked(now)
+}
+
+func (m *Manager) pushTombstoneLocked(ts tombstone) {
+	m.tombstones = append(m.tombstones, ts)
+	if len(m.tombstones) > m.cfg.TombstoneMax {
+		copy(m.tombstones, m.tombstones[1:])
+		m.tombstones[len(m.tombstones)-1] = tombstone{}
+		m.tombstones = m.tombstones[:len(m.tombstones)-1]
+	}
+}
+
+func (m *Manager) tombstoneIndexLocked(id string) (int, bool) {
+	for i, ts := range m.tombstones {
+		if ts.id == id {
+			return i, true
+		}
+	}
+	return 0, false
+}
+
+// AddStep records a step on op applying the manager's ring/message bounds.
+func (m *Manager) AddStep(op *Operation, ts ansible.TaskStep) Step {
+	return op.AddStep(m.cfg.MaxStepsPerOperation, m.cfg.MaxStepMsgBytes, ts)
+}
+
+// Complete finalises op exactly once and runs bounded-history pruning.
+func (m *Manager) Complete(op *Operation, httpStatus int) { m.complete(op, httpStatus) }
+
+// MaxSteps returns the configured per-operation step ring size (used by
+// Operation.AddStep via the API wiring).
+func (m *Manager) MaxSteps() int { return m.cfg.MaxStepsPerOperation }
+
+// MaxStepMsgBytes returns the configured per-step message byte cap.
+func (m *Manager) MaxStepMsgBytes() int { return m.cfg.MaxStepMsgBytes }
+
+// RunningCount returns the number of currently non-terminal operations
+// (metrics gauge backing).
+func (m *Manager) RunningCount() int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.runningCountLocked()
+}
+
+// FinishedCount returns the cumulative number of finalised operations by
+// terminal status.
+func (m *Manager) FinishedCount() map[Status]int64 {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	out := make(map[Status]int64, len(m.finished))
+	for k, v := range m.finished {
+		out[k] = v
+	}
+	return out
+}
+
+// AcceptedCount returns the cumulative number of accepted operations.
+func (m *Manager) AcceptedCount() int64 {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.accepts
+}
diff --git a/internal/operations/manager_test.go b/internal/operations/manager_test.go
new file mode 100644
index 0000000..dc0da24
--- /dev/null
+++ b/internal/operations/manager_test.go
@@ -0,0 +1,323 @@
+package operations
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"dumpstore/internal/ansible"
+)
+
+func testConfig() Config {
+	return Config{
+		MaxStepsPerOperation: 8,
+		MaxStepMsgBytes:      32,
+		RetainMax:            5,
+		RetentionTTL:         time.Hour,
+		TombstoneMax:         3,
+	}
+}
+
+// fakeClock returns a controllable time source.
+type fakeClock struct{ t time.Time }
+
+func newTestManager(cfg Config) (*Manager, *fakeClock) {
+	clk := &fakeClock{t: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}
+	return newManager(cfg, func() time.Time { return clk.t }), clk
+}
+
+func validClientID(n int) string {
+	return fmt.Sprintf("op_00000000-0000-0000-0000-%012x", n)
+}
+
+func step(name, status string) ansible.TaskStep {
+	return ansible.TaskStep{Name: name, Status: status, Msg: "ok"}
+}
+
+func TestStartAssignsIDsAndRejectsBadID(t *testing.T) {
+	m, _ := newTestManager(testConfig())
+
+	op, outcome, err := m.Start("", "dataset.create", "tank/x", "req-1")
+	if err != nil || outcome != StartCreated {
+		t.Fatalf("server id start: op=%v outcome=%v err=%v", op, outcome, err)
+	}
+	if len(op.ID()) != 24 {
+		t.Fatalf("server id = %q, want 24 hex chars", op.ID())
+	}
+
+	cid := validClientID(1)
+	op2, outcome, err := m.Start(cid, "dataset.create", "tank/y", "req-2")
+	if err != nil || outcome != StartCreated || op2.ID() != cid {
+		t.Fatalf("client id start: %v %v %v", op2, outcome, err)
+	}
+
+	if _, _, err := m.Start("op_guess", "a", "b", ""); !errors.Is(err, ErrInvalidID) {
+		t.Fatalf("bad id err = %v, want ErrInvalidID", err)
+	}
+}
+
+func TestStartIdempotentDoesNotReexecute(t *testing.T) {
+	m, clk := newTestManager(testConfig())
+	cid := validClientID(7)
+
+	op1, o1, err := m.Start(cid, "user.create", "alice", "r1")
+	if err != nil || o1 != StartCreated {
+		t.Fatalf("first start: %v %v", o1, err)
+	}
+	executions := 0
+	m.AddStep(op1, step("create user", "changed"))
+	executions++
+
+	// Replayed while still running.
+	op2, o2, err := m.Start(cid, "user.create", "alice", "r2")
+	if err != nil || o2 != StartReplayRunning || op1 != op2 {
+		t.Fatalf("running replay: %p %v %v", op2, o2, err)
+	}
+
+	m.Complete(op1, 200)
+	clk.t = clk.t.Add(time.Minute)
+
+	// Replayed after terminal: same operation, still one execution.
+	op3, o3, err := m.Start(cid, "user.create", "alice", "r3")
+	if err != nil || o3 != StartReplayTerminal || op1 != op3 {
+		t.Fatalf("terminal replay: %v %v", o3, err)
+	}
+	if executions != 1 {
+		t.Fatalf("operation executed %d times, want 1", executions)
+	}
+	rec := op3.Snapshot()
+	if rec.Status != StatusSucceeded || rec.ID != cid {
+		t.Fatalf("replayed record: %+v", rec)
+	}
+}
+
+func TestAddStepGaplessSeqAndRing(t *testing.T) {
+	m, _ := newTestManager(testConfig())
+	op, _, _ := m.Start(validClientID(2), "x", "", "")
+	for i := 0; i < 20; i++ {
+		m.AddStep(op, step(fmt.Sprintf("task %d", i), "changed"))
+	}
+	rec := op.Snapshot()
+	if rec.SeqLast != 20 {
+		t.Fatalf("SeqLast = %d, want 20", rec.SeqLast)
+	}
+	if len(rec.Steps) != 8 {
+		t.Fatalf("ring retained %d, want 8", len(rec.Steps))
+	}
+	if rec.SeqFirst != 13 || rec.Steps[0].Seq != 13 || rec.Steps[7].Seq != 20 {
+		t.Fatalf("ring window: first=%d steps=%v", rec.SeqFirst, rec.Steps)
+	}
+	// Every step seq gapless in its time: assert published journal saw 1..20
+	events, latest := op.Journal().Replay(0)
+	if latest != 20 || len(events) != 8 {
+		t.Fatalf("journal latest=%d retained=%d", latest, len(events))
+	}
+}
+
+func TestAddStepTruncatesMessage(t *testing.T) {
+	m, _ := newTestManager(testConfig())
+	op, _, _ := m.Start(validClientID(3), "x", "", "")
+	m.AddStep(op, ansible.TaskStep{Name: "big", Status: "changed", Msg: strings.Repeat("x", 200)})
+	rec := op.Snapshot()
+	if len(rec.Steps[0].Msg) > 32 || !strings.HasSuffix(rec.Steps[0].Msg, "…") {
+		t.Fatalf("truncation: %q (%d bytes)", rec.Steps[0].Msg, len(rec.Steps[0].Msg))
+	}
+}
+
+func TestFinishStatesAndPrecedence(t *testing.T) {
+	m, _ := newTestManager(testConfig())
+
+	// Failed then timeout → timeout wins.
+	op, _, _ := m.Start(validClientID(4), "a", "", "")
+	op.MarkFailure("boom")
+	op.MarkTimeout("deadline")
+	m.Complete(op, 500)
+	if got := op.Snapshot().Status; got != StatusTimeout {
+		t.Fatalf("status = %s, want timeout", got)
+	}
+	if op.Snapshot().Error != "deadline" {
+		t.Fatalf("error = %q", op.Snapshot().Error)
+	}
+
+	// Timeout then failure → timeout retained.
+	op2, _, _ := m.Start(validClientID(5), "b", "", "")
+	op2.MarkTimeout("late")
+	op2.MarkFailure("boom")
+	m.Complete(op2, 500)
+	if got := op2.Snapshot().Status; got != StatusTimeout {
+		t.Fatalf("status = %s, want timeout", got)
+	}
+
+	// Plain failure.
+	op3, _, _ := m.Start(validClientID(6), "c", "", "")
+	op3.MarkFailure("nope")
+	m.Complete(op3, 500)
+	if got := op3.Snapshot().Status; got != StatusFailed {
+		t.Fatalf("status = %s, want failed", got)
+	}
+
+	// Success inferred from 2xx.
+	op4, _, _ := m.Start(validClientID(8), "d", "", "")
+	m.Complete(op4, 200)
+	if got := op4.Snapshot().Status; got != StatusSucceeded {
+		t.Fatalf("status = %s, want succeeded", got)
+	}
+
+	// Finish is idempotent.
+	m.Complete(op4, 500)
+	if got := op4.Snapshot().Status; got != StatusSucceeded {
+		t.Fatalf("second Complete changed status to %s", got)
+	}
+	if op4.Snapshot().FinishedAt.IsZero() {
+		t.Fatal("FinishedAt not set")
+	}
+	select {
+	case <-op4.Done():
+	default:
+		t.Fatal("Done channel not closed after finish")
+	}
+}
+
+func TestGetNotFoundExpiredAndTombstone(t *testing.T) {
+	cfg := testConfig()
+	cfg.RetainMax = 1
+	cfg.TombstoneMax = 2
+	m, clk := newTestManager(cfg)
+
+	// Unknown valid ID → not found; malformed lookup → invalid.
+	if _, err := m.Get(validClientID(99)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown id: %v", err)
+	}
+	if _, err := m.Get("not-an-id"); !errors.Is(err, ErrInvalidID) {
+		t.Fatalf("bad lookup: %v", err)
+	}
+
+	// Finish two terminals; RetainMax=1 evicts the oldest to tombstone.
+	op1, _, _ := m.Start(validClientID(10), "a", "", "")
+	m.Complete(op1, 200)
+	clk.t = clk.t.Add(time.Minute)
+	op2, _, _ := m.Start(validClientID(11), "b", "", "")
+	m.Complete(op2, 200)
+
+	if _, err := m.Get(validClientID(10)); !errors.Is(err, ErrExpired) {
+		t.Fatalf("pruned op: %v", err)
+	}
+	if _, _, err := m.Start(validClientID(10), "a", "", ""); !errors.Is(err, ErrExpired) {
+		t.Fatalf("replay pruned id: %v", err)
+	}
+	if op, err := m.Get(validClientID(11)); err != nil || op == nil {
+		t.Fatalf("retained op: %v", err)
+	}
+
+	// After TTL the tombstone itself expires → not found.
+	clk.t = clk.t.Add(2 * time.Hour)
+	if _, err := m.Get(validClientID(10)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("expired tombstone: %v", err)
+	}
+}
+
+func TestBoundedRetentionUnderLoad(t *testing.T) {
+	cfg := testConfig()
+	cfg.RetainMax = 200
+	cfg.TombstoneMax = 256
+	m, clk := newTestManager(cfg)
+
+	for i := 0; i < 10_000; i++ {
+		op, _, err := m.Start("", "x", "", "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		m.Complete(op, 200)
+		if i%97 == 0 {
+			clk.t = clk.t.Add(time.Second)
+		}
+	}
+
+	m.mu.Lock()
+	live := len(m.ops)
+	tomb := len(m.tombstones)
+	running := m.runningCountLocked()
+	m.mu.Unlock()
+
+	if running != 0 {
+		t.Fatalf("running = %d, want 0", running)
+	}
+	if live > cfg.RetainMax {
+		t.Fatalf("live terminals = %d, cap %d", live, cfg.RetainMax)
+	}
+	if tomb > cfg.TombstoneMax {
+		t.Fatalf("tombstones = %d, cap %d", tomb, cfg.TombstoneMax)
+	}
+	if m.AcceptedCount() != 10_000 {
+		t.Fatalf("accepted = %d", m.AcceptedCount())
+	}
+}
+
+func TestSubscribeReplayLiveAndTerminal(t *testing.T) {
+	m, _ := newTestManager(testConfig())
+	op, _, _ := m.Start(validClientID(12), "x", "", "")
+	m.AddStep(op, step("a", "changed"))
+	m.AddStep(op, step("b", "changed"))
+
+	initial, ch, latest := op.Journal().Subscribe(1)
+	if latest != 2 || len(initial) != 1 || initial[0].Seq != 2 {
+		t.Fatalf("replay: latest=%d initial=%v", latest, initial)
+	}
+	m.AddStep(op, step("c", "changed"))
+	select {
+	case ev := <-ch:
+		if ev.Seq != 3 {
+			t.Fatalf("live seq = %d", ev.Seq)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("live event not delivered")
+	}
+
+	m.Complete(op, 200)
+	select {
+	case <-op.Done():
+	case <-time.After(time.Second):
+		t.Fatal("Done not closed")
+	}
+	if !op.Journal().Closed() {
+		t.Fatal("journal not sealed after finish")
+	}
+	// Late subscription replays terminal window.
+	late, _, latest := op.Journal().Subscribe(0)
+	if len(late) != 3 || latest != 3 {
+		t.Fatalf("late replay: %v latest=%d", late, latest)
+	}
+	op.Journal().Unsubscribe(ch)
+}
+
+func TestConcurrentStartSameID(t *testing.T) {
+	m, _ := newTestManager(testConfig())
+	cid := validClientID(42)
+	const n = 50
+	var wg sync.WaitGroup
+	created := 0
+	var mu sync.Mutex
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, outcome, err := m.Start(cid, "x", "", "")
+			if err != nil {
+				t.Errorf("start: %v", err)
+				return
+			}
+			if outcome == StartCreated {
+				mu.Lock()
+				created++
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	if created != 1 {
+		t.Fatalf("created %d operations for one ID, want 1", created)
+	}
+}
